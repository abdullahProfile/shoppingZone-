# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/clothstore
MONGODB_TEST_URI=mongodb://localhost:27017/clothstore_test

# Redis Configuration (for session storage and caching)
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your_super_secret_session_key_change_this_in_production

# Payment Gateway Configuration (Simulated)
PAYMENT_GATEWAY_URL=https://api.example-payment.com
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_api_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
